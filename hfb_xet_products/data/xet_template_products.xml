		<field name="xp_usage">export</field>
		<field name="root_tag">Document</field>
		<field name="namespace" eval="False"/>
		<field name="ns_prefix" eval="False"/>
		<field name="include_xsi" eval="False"/>
		<field name="validate_on_export" eval="False"/>
		<field name="pretty_print" eval="True"/>
		<field name="state">ready</field>
