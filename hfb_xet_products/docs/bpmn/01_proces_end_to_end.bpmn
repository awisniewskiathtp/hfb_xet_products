        <bpmndi:BPMNLabel><dc:Bounds x="796" y="728" width="24" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_Imp_W_GwJoin_di" bpmnElement="Flow_W_Imp_W_GwJoin">
        <di:waypoint x="880" y="570" />
        <di:waypoint x="1140" y="570" />
        <di:waypoint x="1140" y="615" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_Exp_W_GwJoin_di" bpmnElement="Flow_W_Exp_W_GwJoin">
        <di:waypoint x="1070" y="700" />
        <di:waypoint x="1140" y="700" />
        <di:waypoint x="1140" y="665" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_GwJoin_W_SEnd_di" bpmnElement="Flow_W_GwJoin_W_SEnd">
        <di:waypoint x="1165" y="640" />
        <di:waypoint x="1232" y="640" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M_In_di" bpmnElement="M_In">
        <di:waypoint x="820" y="80" />
        <di:waypoint x="820" y="525" />
        <bpmndi:BPMNLabel><dc:Bounds x="828" y="90" width="200" height="14" /></bpmndi:BPMNLabel>
