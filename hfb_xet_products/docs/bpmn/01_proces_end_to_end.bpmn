        <di:waypoint x="625" y="640" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_GwDir_W_Imp_di" bpmnElement="Flow_W_GwDir_W_Imp">
        <di:waypoint x="650" y="615" />
        <di:waypoint x="650" y="570" />
        <di:waypoint x="760" y="570" />
        <bpmndi:BPMNLabel><dc:Bounds x="670" y="552" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_GwDir_W_GwWait_di" bpmnElement="Flow_W_GwDir_W_GwWait">
        <di:waypoint x="650" y="665" />
        <di:waypoint x="650" y="700" />
        <di:waypoint x="795" y="700" />
        <bpmndi:BPMNLabel><dc:Bounds x="670" y="705" width="44" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_GwWait_W_Exp_di" bpmnElement="Flow_W_GwWait_W_Exp">
        <di:waypoint x="845" y="700" />
        <di:waypoint x="950" y="700" />
        <bpmndi:BPMNLabel><dc:Bounds x="900" y="680" width="24" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W_GwWait_W_Wait_di" bpmnElement="Flow_W_GwWait_W_Wait">
        <di:waypoint x="820" y="725" />
