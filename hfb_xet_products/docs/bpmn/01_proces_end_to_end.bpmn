<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_XP01" targetNamespace="http://hadron.eu.com/bpmn/hfb_transfer_order_febelco" exporter="Camunda Modeler" exporterVersion="5.28.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:collaboration id="Collab_XP01" name="XET Products - proces end-to-end">
    <bpmn:participant id="Part_Src" name="Serwer SFTP wystawcy pliku produktów">
    </bpmn:participant>
    <bpmn:participant id="Part_Odoo" name="Odoo 20 - hfb_xet_products" processRef="Process_XP01">
    </bpmn:participant>
    <bpmn:participant id="Part_Dst" name="Serwer SFTP odbiorcy eksportu">
    </bpmn:participant>
    <bpmn:messageFlow id="M_In" name="Plik XML produktów (SFTP get)" sourceRef="Part_Src" targetRef="W_Imp" />
    <bpmn:messageFlow id="M_Out" name="Plik XML eksportu (SFTP put .part + rename)" sourceRef="W_Exp" targetRef="Part_Dst" />
  </bpmn:collaboration>
  <bpmn:process id="Process_XP01" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_XP01">
      <bpmn:lane id="Lane_Admin" name="Administrator">
        <bpmn:flowNodeRef>A_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Init" name="Crony inicjujące">
        <bpmn:flowNodeRef>I_TimerImp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_CreateImp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_EndImp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_TimerExp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_CreateExp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_EndExp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Worker" name="Worker (ir_cron_xp_process)">
        <bpmn:flowNodeRef>W_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_Recover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_Sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A_Start" name="Potrzeba przebiegu poza harmonogramem">
      <bpmn:outgoing>Flow_A_Start_A_Run</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="A_Run" name="Uruchom przebieg teraz [action_run_now]">
      <bpmn:incoming>Flow_A_Start_A_Run</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Run_A_Create</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="A_Create" name="Utwórz przebieg i wywołaj dyspozytora">
      <bpmn:incoming>Flow_A_Run_A_Create</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Create_A_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="A_End" name="Przebieg przetworzony">
      <bpmn:incoming>Flow_A_Create_A_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="I_TimerImp" name="ir_cron_xp_init_import (domyślnie co 1 h)">
      <bpmn:outgoing>Flow_I_TimerImp_I_CreateImp</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_I_TimerImp" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="I_CreateImp" name="Utwórz przebieg importu [fetch · pending]">
      <bpmn:incoming>Flow_I_TimerImp_I_CreateImp</bpmn:incoming>
      <bpmn:outgoing>Flow_I_CreateImp_I_EndImp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="I_EndImp" name="Przebieg w kolejce">
      <bpmn:incoming>Flow_I_CreateImp_I_EndImp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="I_TimerExp" name="ir_cron_xp_init_export (domyślnie co 1 dzień)">
      <bpmn:outgoing>Flow_I_TimerExp_I_CreateExp</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_I_TimerExp" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="I_CreateExp" name="Utwórz przebieg eksportu [select · pending]">
      <bpmn:incoming>Flow_I_TimerExp_I_CreateExp</bpmn:incoming>
      <bpmn:outgoing>Flow_I_CreateExp_I_EndExp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="I_EndExp" name="Przebieg w kolejce">
      <bpmn:incoming>Flow_I_CreateExp_I_EndExp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="W_Timer" name="ir_cron_xp_process (domyślnie co 1 min)">
      <bpmn:outgoing>Flow_W_Timer_W_Recover</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_W_Timer" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="W_Recover" name="Odzyskaj przerwane etapy [_xp_recover_stale]">
      <bpmn:incoming>Flow_W_Timer_W_Recover</bpmn:incoming>
      <bpmn:outgoing>Flow_W_Recover_W_Sub</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="W_Sub" name="Dla każdego przebiegu pending (najpierw import), w budżecie czasu">
      <bpmn:incoming>Flow_W_Recover_W_Sub</bpmn:incoming>
      <bpmn:outgoing>Flow_W_Sub_W_End</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="W_SStart" name="">
        <bpmn:outgoing>Flow_W_SStart_W_GwDir</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="W_GwDir" name="Kierunek?">
        <bpmn:incoming>Flow_W_SStart_W_GwDir</bpmn:incoming>
        <bpmn:outgoing>Flow_W_GwDir_W_Imp</bpmn:outgoing>
        <bpmn:outgoing>Flow_W_GwDir_W_GwWait</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="W_Imp" name="Etapy importu (diagram 02)">
        <bpmn:incoming>Flow_W_GwDir_W_Imp</bpmn:incoming>
        <bpmn:outgoing>Flow_W_Imp_W_GwJoin</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="W_GwWait" name="Trwa import w firmie?">
        <bpmn:incoming>Flow_W_GwDir_W_GwWait</bpmn:incoming>
        <bpmn:outgoing>Flow_W_GwWait_W_Exp</bpmn:outgoing>
        <bpmn:outgoing>Flow_W_GwWait_W_Wait</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="W_Wait" name="Czeka na kolejne wywołanie">
        <bpmn:incoming>Flow_W_GwWait_W_Wait</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="W_Exp" name="Etapy eksportu (diagram 03)">
        <bpmn:incoming>Flow_W_GwWait_W_Exp</bpmn:incoming>
        <bpmn:outgoing>Flow_W_Exp_W_GwJoin</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="W_GwJoin" name="">
        <bpmn:incoming>Flow_W_Imp_W_GwJoin</bpmn:incoming>
        <bpmn:incoming>Flow_W_Exp_W_GwJoin</bpmn:incoming>
        <bpmn:outgoing>Flow_W_GwJoin_W_SEnd</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="W_SEnd" name="">
        <bpmn:incoming>Flow_W_GwJoin_W_SEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_W_SStart_W_GwDir" sourceRef="W_SStart" targetRef="W_GwDir" />
      <bpmn:sequenceFlow id="Flow_W_GwDir_W_Imp" name="import" sourceRef="W_GwDir" targetRef="W_Imp" />
      <bpmn:sequenceFlow id="Flow_W_GwDir_W_GwWait" name="eksport" sourceRef="W_GwDir" targetRef="W_GwWait" />
      <bpmn:sequenceFlow id="Flow_W_GwWait_W_Exp" name="nie" sourceRef="W_GwWait" targetRef="W_Exp" />
      <bpmn:sequenceFlow id="Flow_W_GwWait_W_Wait" name="tak" sourceRef="W_GwWait" targetRef="W_Wait" />
      <bpmn:sequenceFlow id="Flow_W_Imp_W_GwJoin" sourceRef="W_Imp" targetRef="W_GwJoin" />
      <bpmn:sequenceFlow id="Flow_W_Exp_W_GwJoin" sourceRef="W_Exp" targetRef="W_GwJoin" />
      <bpmn:sequenceFlow id="Flow_W_GwJoin_W_SEnd" sourceRef="W_GwJoin" targetRef="W_SEnd" />
    </bpmn:subProcess>
    <bpmn:endEvent id="W_End" name="Koniec wywołania">
      <bpmn:incoming>Flow_W_Sub_W_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A_Start_A_Run" sourceRef="A_Start" targetRef="A_Run" />
    <bpmn:sequenceFlow id="Flow_A_Run_A_Create" sourceRef="A_Run" targetRef="A_Create" />
    <bpmn:sequenceFlow id="Flow_A_Create_A_End" sourceRef="A_Create" targetRef="A_End" />
    <bpmn:sequenceFlow id="Flow_I_TimerImp_I_CreateImp" sourceRef="I_TimerImp" targetRef="I_CreateImp" />
    <bpmn:sequenceFlow id="Flow_I_CreateImp_I_EndImp" sourceRef="I_CreateImp" targetRef="I_EndImp" />
    <bpmn:sequenceFlow id="Flow_I_TimerExp_I_CreateExp" sourceRef="I_TimerExp" targetRef="I_CreateExp" />
    <bpmn:sequenceFlow id="Flow_I_CreateExp_I_EndExp" sourceRef="I_CreateExp" targetRef="I_EndExp" />
    <bpmn:sequenceFlow id="Flow_W_Timer_W_Recover" sourceRef="W_Timer" targetRef="W_Recover" />
    <bpmn:sequenceFlow id="Flow_W_Recover_W_Sub" sourceRef="W_Recover" targetRef="W_Sub" />
    <bpmn:sequenceFlow id="Flow_W_Sub_W_End" sourceRef="W_Sub" targetRef="W_End" />
    <bpmn:textAnnotation id="N_Init"><bpmn:text>Pomija kanał, który ma trwający przebieg (unikalny indeks: jeden przebieg pending/running na kanał).</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab_XP01">
    <bpmndi:BPMNPlane id="BPMNPlane_Collab_XP01" bpmnElement="Collab_XP01">
      <bpmndi:BPMNShape id="Part_Src_di" bpmnElement="Part_Src" isHorizontal="true">
        <dc:Bounds x="160" y="20" width="1500" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Odoo_di" bpmnElement="Part_Odoo" isHorizontal="true">
