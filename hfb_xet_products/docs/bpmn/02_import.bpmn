<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_XP02" targetNamespace="http://hadron.eu.com/bpmn/hfb_transfer_order_febelco" exporter="Camunda Modeler" exporterVersion="5.28.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:collaboration id="Collab_XP02" name="XET Products - przebieg importu">
    <bpmn:participant id="Part_Src" name="Serwer SFTP wystawcy pliku produktów">
    </bpmn:participant>
    <bpmn:participant id="Part_W" name="Odoo 20 - worker, przebieg importu (communication.log)" processRef="Process_XP02">
    </bpmn:participant>
    <bpmn:participant id="Part_Img" name="Serwer zdjęć (HTTP/HTTPS)">
    </bpmn:participant>
    <bpmn:messageFlow id="M_Get" name="Plik XML (get)" sourceRef="Part_Src" targetRef="T_Fetch" />
    <bpmn:messageFlow id="M_Img" name="GET obrazu" sourceRef="I_Get" targetRef="Part_Img" />
    <bpmn:messageFlow id="M_Move" name="Przeniesienie do archiwum" sourceRef="T_Fin" targetRef="Part_Src" />
  </bpmn:collaboration>
  <bpmn:process id="Process_XP02" isExecutable="false">
    <bpmn:startEvent id="S" name="Przebieg importu [fetch · pending]">
      <bpmn:outgoing>Flow_S_T_Fetch</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_Fetch" name="fetch: wybierz i pobierz plik [_xp_stage_fetch]">
      <bpmn:incoming>Flow_S_T_Fetch</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Fetch_G_File</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_File" name="Plik pasuje do wzorca?" default="Flow_G_File_E_NoFile">
      <bpmn:incoming>Flow_T_Fetch_G_File</bpmn:incoming>
      <bpmn:outgoing>Flow_G_File_T_Parse</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_File_E_NoFile</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_NoFile" name="Brak danych [nofile]">
      <bpmn:incoming>Flow_G_File_E_NoFile</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Parse" name="parse: parser → xp.staging.line [_xp_stage_parse]">
      <bpmn:incoming>Flow_G_File_T_Parse</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Parse_G_Xml</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Xml" name="Plik XML poprawny?" default="Flow_G_Xml_T_ErrDir">
      <bpmn:incoming>Flow_T_Parse_G_Xml</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Xml_Sub_Apply</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Xml_T_ErrDir</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ErrDir" name="Wynik error, plik → katalog błędów [_xp_on_run_error]">
      <bpmn:incoming>Flow_G_Xml_T_ErrDir</bpmn:incoming>
      <bpmn:outgoing>Flow_T_ErrDir_E_Err</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Err" name="Błąd [error]">
      <bpmn:incoming>Flow_T_ErrDir_E_Err</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_Apply" name="apply: dla każdej linii draft (partiami, savepoint na linię)">
      <bpmn:incoming>Flow_G_Xml_Sub_Apply</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Apply_G_Img</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="A_S" name="">
        <bpmn:outgoing>Flow_A_S_A_Find</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="A_Find" name="Szukaj product.product po SKU + EAN">
        <bpmn:incoming>Flow_A_S_A_Find</bpmn:incoming>
        <bpmn:outgoing>Flow_A_Find_A_G</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A_G" name="Znaleziono?">
        <bpmn:incoming>Flow_A_Find_A_G</bpmn:incoming>
        <bpmn:outgoing>Flow_A_G_A_Upd</bpmn:outgoing>
        <bpmn:outgoing>Flow_A_G_A_New</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_Upd" name="Zapisz tylko zmienione pola [updated / unchanged]">
        <bpmn:incoming>Flow_A_G_A_Upd</bpmn:incoming>
        <bpmn:outgoing>Flow_A_Upd_A_E</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="A_New" name="Utwórz produkt i media [created]">
        <bpmn:incoming>Flow_A_G_A_New</bpmn:incoming>
        <bpmn:outgoing>Flow_A_New_A_E</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="A_E" name="">
        <bpmn:incoming>Flow_A_Upd_A_E</bpmn:incoming>
        <bpmn:incoming>Flow_A_New_A_E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A_S_A_Find" sourceRef="A_S" targetRef="A_Find" />
      <bpmn:sequenceFlow id="Flow_A_Find_A_G" sourceRef="A_Find" targetRef="A_G" />
      <bpmn:sequenceFlow id="Flow_A_G_A_Upd" name="tak" sourceRef="A_G" targetRef="A_Upd" />
      <bpmn:sequenceFlow id="Flow_A_G_A_New" name="nie" sourceRef="A_G" targetRef="A_New" />
      <bpmn:sequenceFlow id="Flow_A_Upd_A_E" sourceRef="A_Upd" targetRef="A_E" />
      <bpmn:sequenceFlow id="Flow_A_New_A_E" sourceRef="A_New" targetRef="A_E" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G_Img" name="Pobieranie zdjęć włączone?" default="Flow_G_Img_T_Fin">
      <bpmn:incoming>Flow_Sub_Apply_G_Img</bpmn:incoming>
      <bpmn:outgoing>Flow_G_Img_Sub_Img</bpmn:outgoing>
      <bpmn:outgoing>Flow_G_Img_T_Fin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_Img" name="images: dla każdej linii processed">
      <bpmn:incoming>Flow_G_Img_Sub_Img</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Img_T_Fin</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="I_S" name="">
        <bpmn:outgoing>Flow_I_S_I_Get</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="I_Get" name="Pobierz obraz, gdy URL inny niż xp_image_source_url">
        <bpmn:incoming>Flow_I_S_I_Get</bpmn:incoming>
        <bpmn:outgoing>Flow_I_Get_I_E</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="I_E" name="">
        <bpmn:incoming>Flow_I_Get_I_E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_I_S_I_Get" sourceRef="I_S" targetRef="I_Get" />
      <bpmn:sequenceFlow id="Flow_I_Get_I_E" sourceRef="I_Get" targetRef="I_E" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="T_Fin" name="finalize: liczniki, wynik, plik → archiwum">
      <bpmn:incoming>Flow_G_Img_T_Fin</bpmn:incoming>
      <bpmn:incoming>Flow_Sub_Img_T_Fin</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Fin_E_Ok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Ok" name="Zakończony [accepted / manual]">
      <bpmn:incoming>Flow_T_Fin_E_Ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_T_Fetch" sourceRef="S" targetRef="T_Fetch" />
    <bpmn:sequenceFlow id="Flow_T_Fetch_G_File" sourceRef="T_Fetch" targetRef="G_File" />
    <bpmn:sequenceFlow id="Flow_G_File_T_Parse" name="tak" sourceRef="G_File" targetRef="T_Parse" />
    <bpmn:sequenceFlow id="Flow_G_File_E_NoFile" name="nie" sourceRef="G_File" targetRef="E_NoFile" />
    <bpmn:sequenceFlow id="Flow_T_Parse_G_Xml" sourceRef="T_Parse" targetRef="G_Xml" />
    <bpmn:sequenceFlow id="Flow_G_Xml_Sub_Apply" name="tak" sourceRef="G_Xml" targetRef="Sub_Apply" />
    <bpmn:sequenceFlow id="Flow_G_Xml_T_ErrDir" name="nie" sourceRef="G_Xml" targetRef="T_ErrDir" />
    <bpmn:sequenceFlow id="Flow_T_ErrDir_E_Err" sourceRef="T_ErrDir" targetRef="E_Err" />
    <bpmn:sequenceFlow id="Flow_Sub_Apply_G_Img" sourceRef="Sub_Apply" targetRef="G_Img" />
    <bpmn:sequenceFlow id="Flow_G_Img_Sub_Img" name="tak" sourceRef="G_Img" targetRef="Sub_Img" />
    <bpmn:sequenceFlow id="Flow_G_Img_T_Fin" name="nie" sourceRef="G_Img" targetRef="T_Fin" />
    <bpmn:sequenceFlow id="Flow_Sub_Img_T_Fin" sourceRef="Sub_Img" targetRef="T_Fin" />
    <bpmn:sequenceFlow id="Flow_T_Fin_E_Ok" sourceRef="T_Fin" targetRef="E_Ok" />
    <bpmn:textAnnotation id="N_Err"><bpmn:text>Wyjątek etapu: ponowienie po retry_delay_minutes, po max_attempts wynik error. Błąd zapisu linii (apply) lub pobrania obrazu (images) nie przerywa przebiegu.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab_XP02">
    <bpmndi:BPMNPlane id="BPMNPlane_Collab_XP02" bpmnElement="Collab_XP02">
